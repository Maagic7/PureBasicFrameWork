; ==============================================================================
;  Module:       Fluid (Fluid Mechanics for Hydraulics & Pneumatics)
;  Filename:     PbFw_Module_FluidMechanics.pb
;  Dependencies: Requires UC Module for unit conversion in main application
; ==============================================================================

; XIncludeFile "PbFw_Module_FLUID.pb"     ; FLUID::     Water Thermodynamics 

;- ----------------------------------------------------------------------
;- Include Files
;  ----------------------------------------------------------------------

; XIncludeFile "..\PbFw_Module_PbFw.pb"     ; PbFw::     FrameWork control Module

XIncludeFile "PbFw_Module_TD.pb"           ; TD::       Basic Thermodynamics Core

DeclareModule Fluid
  EnableExplicit
  
  ; --- Industrial Reference Constants (ISO 6358 / ANR Standard) ---
  #ANR_TEMPERATURE_KELVIN = 293.15  ; 20 °C in Kelvin
  #ANR_PRESSURE_PASCAL     = 101325.0 ; 1.01325 bar (Standard Atmosphere)
  #R_SPECIFIC_AIR          = 287.058  ; Specific gas constant for dry air in J/(kg·K)

  ; --- Public Function Declarations ---
  
  ; Geometries & Areas
  Declare.d AreaFromDiameter(DiameterM.d)
  Declare.d CylinderRingArea(PistonDiameterM.d, RodDiameterM.d)
  
  ; Cylinder Mechanics & Velocities
  Declare.d CylinderForce(PressurePascal.d, EffectiveAreaSqm.d)
  Declare.d CylinderVelocity(VolumetricFlowM3s.d, EffectiveAreaSqm.d)
  Declare.d CylinderRequiredFlow(VelocityMs.d, EffectiveAreaSqm.d)
  
  ; Hydraulic Flow Dynamics (Incompressible)
  Declare.d Flow_HydraulicVelocity(VolumetricFlowM3s.d, AreaSqm.d)
  Declare.d Flow_HydraulicVolumeRate(AreaSqm.d, VelocityMs.d)
  Declare.d OptimalPipeDiameter(VolumetricFlowM3s.d, TargetVelocityMs.d)
  
  ; Pneumatic Flow Dynamics (Compressible according to ISO 6358)
  ; Calculates mass flow rate (kg/s) through a pneumatic restriction / valve
  Declare.d Flow_PneumaticMassRate(UpstreamPressurePa.d, DownstreamPressurePa.d, TemperatureKelvin.d, SonicConductanceC.d, CriticalPressureRatioB.d)
  ; Converts mass flow rate to standard volume flow rate ANR (m³/s)
  Declare.d MassFlowToNormalVolumetricFlow(MassFlowKgS.d)
  
  ; Hydraulic Pumps & Motors
  Declare.d PumpFlowRate(DisplacementM3PerRev.d, SpeedRPM.d, VolumetricEfficiency.d = 1.0)
    
  ; Pneumatic Normal Flow Conversion
  Declare.d OperatingToNormalFlow(OperatingFlowM3s.d, OperatingPressurePascal.d, OperatingTemperatureKelvin.d)
EndDeclareModule

Module Fluid
  
  EnableExplicit
  
  Procedure.d AreaFromDiameter(DiameterM.d)
  ; ============================================================================
  ; NAME: AreaFromDiameter
  ; DESC: Calculates the circular cross-sectional area from a given diameter.
  ; VAR(DiameterM.d)      : The diameter of the circle or pipe in meters (m)
  ; RET.d                 : The calculated area in square meters (m²)
  ; ============================================================================
    ProcedureReturn DiameterM * DiameterM * (#PI/4)
  EndProcedure

  Procedure.d CylinderRingArea(PistonDiameterM.d, RodDiameterM.d)
  ; ============================================================================
  ; NAME: CylinderRingArea
  ; DESC: Calculates the effective pulling area (ring area) of a cylinder by 
  ;       subtracting the rod area from the piston area.
  ; VAR(PistonDiameterM.d): The full diameter of the cylinder piston in meters (m)
  ; VAR(RodDiameterM.d)   : The diameter of the piston rod in meters (m)
  ; RET.d                 : The effective rod-side area in square meters (m²)
  ; ============================================================================
    Protected PistonArea.d = AreaFromDiameter(PistonDiameterM)
    Protected RodArea.d    = AreaFromDiameter(RodDiameterM)
    ProcedureReturn PistonArea - RodArea
  EndProcedure

  Procedure.d CylinderForce(PressurePascal.d, EffectiveAreaSqm.d)
  ; ============================================================================
  ; NAME: CylinderForce
  ; DESC: Calculates the theoretical force generated by a cylinder.
  ; VAR(PressurePascal.d) : The hydraulic or pneumatic pressure in Pascals (Pa)
  ; VAR(EffectiveAreaSqm.d): The active surface area (piston or ring) in m²
  ; RET.d                 : The resulting force in Newtons (N)
  ; ============================================================================
    ProcedureReturn PressurePascal * EffectiveAreaSqm
  EndProcedure

  Procedure.d CylinderVelocity(VolumetricFlowM3s.d, EffectiveAreaSqm.d)
  ; ============================================================================
  ; NAME: CylinderVelocity
  ; DESC: Calculates the travel speed of a cylinder piston from a given volume flow.
  ; VAR(VolumetricFlowM3s.d) : The incoming fluid flow rate in cubic meters per second (m³/s)
  ; VAR(EffectiveAreaSqm.d)  : The active surface area (piston or ring) in m²
  ; RET.d                    : The resulting piston velocity in meters per second (m/s)
  ; ============================================================================
    If EffectiveAreaSqm = 0.0 : ProcedureReturn 0.0 : EndIf
    ProcedureReturn VolumetricFlowM3s / EffectiveAreaSqm
  EndProcedure

  Procedure.d CylinderRequiredFlow(VelocityMs.d, EffectiveAreaSqm.d)
  ; ============================================================================
  ; NAME: CylinderRequiredFlow
  ; DESC: Calculates the volumetric flow rate required to move a cylinder at a target speed.
  ; VAR(VelocityMs.d)     : The target travel speed of the piston in meters per second (m/s)
  ; VAR(EffectiveAreaSqm.d): The active surface area (piston or ring) in m²
  ; RET.d                 : The required fluid flow rate in cubic meters per second (m³/s)
  ; ============================================================================
    ProcedureReturn VelocityMs * EffectiveAreaSqm
  EndProcedure

  Procedure.d Flow_HydraulicVelocity(VolumetricFlowM3s.d, AreaSqm.d)
  ; ============================================================================
  ; NAME: Flow_HydraulicVelocity
  ; DESC: Calculates the flow speed of an incompressible fluid inside a pipe or hose.
  ; VAR(VolumetricFlowM3s.d) : The fluid flow rate in cubic meters per second (m³/s)
  ; VAR(AreaSqm.d)           : The internal cross-sectional area of the pipe in m²
  ; RET.d                    : The mean fluid velocity in meters per second (m/s)
  ; ============================================================================
    If AreaSqm = 0.0 : ProcedureReturn 0.0 : EndIf
    ProcedureReturn VolumetricFlowM3s / AreaSqm
  EndProcedure

  Procedure.d Flow_HydraulicVolumeRate(AreaSqm.d, VelocityMs.d)
  ; ============================================================================
  ; NAME: Flow_HydraulicVolumeRate
  ; DESC: Calculates the volumetric flow rate of a fluid passing through a given pipe area.
  ; VAR(AreaSqm.d)     : The internal cross-sectional area of the pipe in m²
  ; VAR(VelocityMs.d)  : The fluid flow speed inside the pipe in meters per second (m/s)
  ; RET.d              : The fluid flow rate in cubic meters per second (m³/s)
  ; ============================================================================
    ProcedureReturn AreaSqm * VelocityMs
  EndProcedure

  Procedure.d OptimalPipeDiameter(VolumetricFlowM3s.d, TargetVelocityMs.d)
  ; ============================================================================
  ; NAME: OptimalPipeDiameter
  ; DESC: Calculates the required internal pipe diameter to maintain a recommended 
  ;       fluid velocity (prevents pressure drops and turbulence).
  ; VAR(VolumetricFlowM3s.d) : The fluid flow rate in cubic meters per second (m³/s)
  ; VAR(TargetVelocityMs.d)  : The desired maximum flow speed (e.g., 5.0 m/s for hydraulics)
  ; RET.d                    : The minimum required inner pipe diameter in meters (m)
  ; ============================================================================
    If TargetVelocityMs = 0.0 : ProcedureReturn 0.0 : EndIf
    Protected RequiredArea.d = VolumetricFlowM3s / TargetVelocityMs
    ProcedureReturn Sqr(RequiredArea * 4.0 / #PI)
  EndProcedure

  Procedure.d Flow_PneumaticMassRate(UpstreamPressurePa.d, DownstreamPressurePa.d, TemperatureKelvin.d, SonicConductanceC.d, CriticalPressureRatioB.d)
  ; ============================================================================
  ; NAME: Flow_PneumaticMassRate
  ; DESC: Calculates the pneumatic mass flow rate through a valve or restriction 
  ;       according to ISO 6358 (handles choked and subsonic flow conditions).
  ; VAR(UpstreamPressurePa.d)   : The inlet/supply absolute pressure in Pascals (Pa)
  ; VAR(DownstreamPressurePa.d) : The outlet/exhaust absolute pressure in Pascals (Pa)
  ; VAR(TemperatureKelvin.d)    : The absolute temperature of the air in Kelvin (K)
  ; VAR(SonicConductanceC.d)    : The sonic conductance of the component in m³/(s·Pa)
  ; VAR(CriticalPressureRatioB.d): The critical pressure ratio (dimensionless, 0.0 - 1.0)
  ; RET.d                       : The actual air mass flow rate in kilograms per second (kg/s)
  ; ============================================================================
    If UpstreamPressurePa <= 0.0 Or TemperatureKelvin <= 0.0 : ProcedureReturn 0.0 : EndIf
    
    Protected PressureRatio.d = DownstreamPressurePa / UpstreamPressurePa
    Protected DensityStandard.d = #ANR_PRESSURE_PASCAL / (#R_SPECIFIC_AIR * #ANR_TEMPERATURE_KELVIN)
    Protected MassFlow.d = 0.0
    Protected TempFactor.d = Sqr(#ANR_TEMPERATURE_KELVIN / TemperatureKelvin)
    
    If PressureRatio <= CriticalPressureRatioB
      MassFlow = UpstreamPressurePa * SonicConductanceC * DensityStandard * TempFactor
    Else
      Protected SubsonicFactor.d = Sqr(1.0 - Pow((PressureRatio - CriticalPressureRatioB) / (1.0 - CriticalPressureRatioB), 2))
      MassFlow = UpstreamPressurePa * SonicConductanceC * DensityStandard * TempFactor * SubsonicFactor
    EndIf
    
    ProcedureReturn MassFlow
  EndProcedure

  Procedure.d MassFlowToNormalVolumetricFlow(MassFlowKgS.d)
  ; ============================================================================
  ; NAME: MassFlowToNormalVolumetricFlow
  ; DESC: Converts an air mass flow rate into a standard volumetric flow rate 
  ;       under standard atmospheric reference conditions (ANR).
  ; VAR(MassFlowKgS.d): The mass flow rate in kilograms per second (kg/s)
  ; RET.d             : The volumetric flow rate at ANR standard in cubic meters per second (m³/s)
  ; ============================================================================
    Protected DensityStandard.d = #ANR_PRESSURE_PASCAL / (#R_SPECIFIC_AIR * #ANR_TEMPERATURE_KELVIN)
    If DensityStandard = 0.0 : ProcedureReturn 0.0 : EndIf
    ProcedureReturn MassFlowKgS / DensityStandard
  EndProcedure

  Procedure.d PumpFlowRate(DisplacementM3PerRev.d, SpeedRPM.d, VolumetricEfficiency.d = 1.0)
  ; ============================================================================
  ; NAME: PumpFlowRate
  ; DESC: Calculates the true volumetric output flow rate of a hydraulic pump 
  ;       taking volumetric losses (internal leakage) into account.
  ; VAR(DisplacementM3PerRev.d): The pump displacement volume per revolution in m³/rev
  ; VAR(SpeedRPM.d)            : The rotational shaft speed in revolutions per minute (RPM)
  ; VAR(VolumetricEfficiency.d): The efficiency rating (0.0 to 1.0, e.g., 0.92 for 92%)
  ; RET.d                      : The actual delivered flow rate in cubic meters per second (m³/s)
  ; ============================================================================
    Protected SpeedPerSecond.d = SpeedRPM / 60.0
    ProcedureReturn DisplacementM3PerRev * SpeedPerSecond * VolumetricEfficiency
  EndProcedure

  Procedure.d OperatingToNormalFlow(OperatingFlowM3s.d, OperatingPressurePascal.d, OperatingTemperatureKelvin.d)
  ; ============================================================================
  ; NAME: OperatingToNormalFlow
  ; DESC: Converts an actual operational gas volume flow under pressure and temperature
  ;       to standard conditions (ANR according to ISO 6358).
  ; VAR(OperatingFlowM3s.d)      : The actual flow rate under system conditions in m³/s
  ; VAR(OperatingPressurePascal.d): The absolute system operational pressure in Pascals (Pa)
  ; VAR(OperatingTemperatureKelvin.d): The actual temperature of the flowing gas in Kelvin (K)
  ; RET.d                        : The equivalent standard flow rate at ANR in m³/s
  ; ============================================================================
    Protected.d NormalFlow
    
    If OperatingTemperatureKelvin = 0.0 
      ProcedureReturn 0.0 
    EndIf
    
    NormalFlow.d = (OperatingPressurePascal * OperatingFlowM3s * #ANR_TEMPERATURE_KELVIN) / (OperatingTemperatureKelvin * #ANR_PRESSURE_PASCAL)
    ProcedureReturn NormalFlow
  EndProcedure

EndModule


;- --- Verification Test ---
CompilerIf #PB_Compiler_IsMainFile
  OpenConsole("Fluid Module - Advanced Flow Quality Check")
  
  ; ----------------------------------------------------------------------------
  ; COMPRESSIBLE PNEUMATIC FLOW TEST (ISO 6358)
  ; ----------------------------------------------------------------------------
  PrintN("--- Pneumatic Valve Flow (ISO 6358) ---")
  ; Valve Parameters: C = 2.0 * 10^-8 m³/(s·Pa), b = 0.3
  ; Supply pressure = 7 Bar abs, Exhausting to Atmosphere (1 Bar abs) at 20°C
  Define P_Upstream.d   = 700000.0  ; 7 bar
  Define P_Downstream.d = 100000.0  ; 1 bar
  Define Temp.d         = 293.15    ; 20 °C
  Define ConductanceC.d = 2.0e-8
  Define CriticalB.d    = 0.3
  
  Define MassFlow.d = Fluid::Flow_PneumaticMassRate(P_Upstream, P_Downstream, Temp, ConductanceC, CriticalB)
  Define VolFlowANR.d = Fluid::MassFlowToNormalVolumetricFlow(MassFlow)
  
  PrintN("Pneumatic Mass Flow: " + StrD(MassFlow, 6) + " kg/s")
  PrintN("Volumetric Flow ANR: " + StrD(VolFlowANR * 60000.0, 1) + " Nl/min")
  Input()
CompilerEndIf

