CompilerIf #PB_Compiler_IsMainFile    
  ;- ----------------------------------------------------------------------
  ;- CODE GENERATION TOOLS
  ;- ----------------------------------------------------------------------
  EnableExplicit
    
  Structure TStepKeyWord
    ID.i        ; ID Number of the STEP Function
    Name.s      ; Name
    *Procedure  ; Procedure-Pointer to call STEP-Function Procedure by ID or Name
  EndStructure
  
Global NewList lstKeyWords.TStepKeyWord()

Procedure.i LoadKeywords(List lst.TStepKeyWord())
  Protected I, ID
  Protected sID.s, txt.s
  
  If ListSize(lst())
    ClearList(lst())
  EndIf
  
  ResetList(lst())

  Restore STEP_KeyWords
  
  Repeat
    Read.s sID
    Read.s txt
    
    I = Val(sID)  
    
    If txt ="---"
      Break  
    Else
      AddElement(lst())     
      lst()\ID = I
      lst()\Name = txt
    EndIf    
  ForEver
  
  ProcedureReturn I
EndProcedure

#dblQuotes = Chr(34)

Procedure CreateDataSection_KeyWord(List lst.TStepKeyWord())
  Protected I  
  Protected line.s = ""
  
  
  ResetList(lst())
  Debug "ListSize = " + ListSize(lst())
  
  ForEach lst()
    I +1 
    line = line + Space(2) + "Data.s " + #dblQuotes + I + #dblQuotes + ", " +  #dblQuotes + lst()\Name + #dblQuotes + #CRLF$
  Next
  line = line + #dblQuotes + "---" + #dblQuotes + ", " + #dblQuotes + "---" + #dblQuotes    ; END-Line
  
  ClearClipboard()       ; Clear the Clipboard
  SetClipboardText(line) ; Paste text to the clipboard..  
EndProcedure

Procedure CreateKeyWordConstants(List lst.TStepKeyWord())
  Protected I  
  Protected line.s = ""
    
  ResetList(lst())
  Debug "ListSize = " + ListSize(lst())
  
  ForEach lst()
    I +1 
    line = line + "#STEP_" + lst()\Name + " = " + lst()\ID + #CRLF$
  Next
  
  ClearClipboard()  ; Clear the Clipboard
  SetClipboardText(line) ; Paste text to the clipboard..  
EndProcedure

Procedure CreateDataSection_VTable(List lst.TStepKeyWord())
  Protected I  
  Protected line.s = ""  
  
  ResetList(lst())
  Debug "ListSize = " + ListSize(lst())
  
  ForEach lst()
     line = line + Space(2) + "Data.i @STEP_" + lst()\Name  +"()  ; " + lst()\ID + #CRLF$
  Next
  
  ClearClipboard()       ; Clear the Clipboard
  SetClipboardText(line) ; Paste text to the clipboard..  
EndProcedure

Procedure CreateStepProcedures(List lst.TStepKeyWord())
  Protected I  
  Protected line.s = "" 
  
  ResetList(lst())
  Debug "ListSize = " + ListSize(lst())
  
  ForEach lst()
     line + " " +  #CRLF$
     line + "Procedure STEP_" + lst()\Name + "(sTxt.s)" + #CRLF$
     line + Space(2) + "Protected I"  + #CRLF$
     line +  #CRLF$
     line + "EndProcedure"
     line + " " + #CRLF$
  Next
   
  ClearClipboard()       ; Clear the Clipboard
  SetClipboardText(line) ; Paste text to the clipboard..  
EndProcedure

Procedure CreateStep_CreateAllocateStructureProcedures(List lst.TStepKeyWord())
  Protected I  
  Protected line.s = "" 
  Protected sData.s = ""
  Protected SName.s ; Structure Name
  
  ResetList(lst())
  Debug "ListSize = " + ListSize(lst())
  
  ForEach lst()
    SName = "T_" + lst()\Name
    line + " " +  #CRLF$
    line + "Procedure.i AllocateStructure_" + lst()\Name + "()" + "; ID = " + Str(lst()\ID) + #CRLF$
    line + Space(2) + "Protected *Struct." + SName + #CRLF$
    Line + Space(2) + "*Struct = AllocateStructure(" + SName +")" +  #CRLF$
    Line + Space(2) + "With *Struct" + #CRLF$
    Line + Space(2) + "  \ID = " + lst()\ID + #CRLF$
    Line + Space(2) + "EndWith" + #CRLF$ 
    line + Space(2) + "ProcedureReturn *Struct" + #CRLF$
    ;line +  #CRLF$
    line + "EndProcedure"
    line + " " + #CRLF$
  Next
   
  ClearClipboard()       ; Clear the Clipboard
  SetClipboardText(line) ; Paste text to the clipboard..  
  
  sData + "Datasection" +  #CRLF$
  sData = "  AllocateSructureProcs:" +  #CRLF$
  ForEach lst()
    SName = "AllocateStructure_" + lst()\Name
    sData + "  Data.i @" + SName +  "() ; " + lst()\ID + #CRLF$ 
  Next
  sData + "EndDatasection" +  #CRLF$
  SetClipboardText(line + sData) ; Paste text to the clipboard..  

EndProcedure

Procedure CreateStepStructs(List lst.TStepKeyWord())
  Protected I  
  Protected line.s = "" 
  
  ResetList(lst())
  Debug "ListSize = " + ListSize(lst())
  Line + "Structure TStepBase" +  #CRLF$
  Line + "  ID.i            ; This the Function/Object ID from the Step decoumentation" +  #CRLF$
  Line + "  Label.s         ; This is the Name " +  #CRLF$
  Line + "EndStructure" +  #CRLF$
  Line + " " +   #CRLF$
  
  ForEach lst()
    line + " " +  #CRLF$
    Line + " ; " + Str(lst()\ID) + " : " + lst()\Name  +  #CRLF$
    line + "Structure T_" + lst()\Name +  " Extends TStepBase ; ID= " + Str(lst()\ID) + #CRLF$
    line + Space(2) + #CRLF$
    line + "EndStructure"
    line + " " + #CRLF$
  Next
   
  ClearClipboard()       ; Clear the Clipboard
  SetClipboardText(line) ; Paste text to the clipboard..  
  
EndProcedure

Debug LoadKeywords(lstKeyWords())
;CreateDataSection_KeyWord(lstKeyWords())
;CreateKeyWordConstants(lstKeyWords())
;CreateDataSection_VTable(lstKeyWords())
;CreateStepProcedures(lstKeyWords())
CreateStepStructs(lstKeyWords())
;CreateStep_CreateAllocateStructureProcedures(lstKeyWords())

CompilerEndIf
  
