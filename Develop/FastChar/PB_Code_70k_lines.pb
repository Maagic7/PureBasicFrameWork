  #rptAsyncPreview= 0 ;	Preview mode. Occurs after invoking the Show method.
  #rptAsyncPrint  = 1 	; Indicates a job has been sent To the printer.
  #rptAsyncExport =	2 	; Indicates a file is being exported.
  
