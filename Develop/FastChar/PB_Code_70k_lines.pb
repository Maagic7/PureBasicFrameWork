; ----------------------------------------------------------------------
Prototype.i Invoke_AllocateStructure()

Procedure.i AcllocateStructureByID(ID)
  Protected *Struct
  Protected Invoke.Invoke_AllocateStructure
  
  If ID >0 And ID< 2273
   ; Invoke = *AllocateStruct[ID]
    If Invoke 
      Invoke()
    EndIf
    
  Else
    MessageRequester("Step ProcedureID out of Range", "Step::AllocateStructureByID(); ID = " + Str(ID) + " : out of range 1..2273")
  EndIf
  
  ProcedureReturn *Struct
EndProcedure
